<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================= Palette ================= -->

    <Color x:Key="TitleBarColor">#FF15161B</Color>
    <Color x:Key="SidebarColor">#FF1D1E26</Color>
    <Color x:Key="SidebarHoverColor">#FF282A35</Color>
    <Color x:Key="SidebarSelectedColor">#FF2F3242</Color>
    <Color x:Key="AccentColor">#FF2F7CF6</Color>
    <Color x:Key="AccentHoverColor">#FF1D66DB</Color>
    <Color x:Key="ContentColor">#FFF4F5F8</Color>

    <SolidColorBrush x:Key="TitleBarBackground" Color="{StaticResource TitleBarColor}"/>
    <SolidColorBrush x:Key="TitleBarForeground" Color="#FFE9EAF0"/>
    <SolidColorBrush x:Key="TitleBarDimForeground" Color="#FF8A8D9B"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarForeground" Color="#FFC3C6D2"/>
    <SolidColorBrush x:Key="SidebarDimForeground" Color="#FF83869A"/>
    <SolidColorBrush x:Key="SidebarHoverBackground" Color="{StaticResource SidebarHoverColor}"/>
    <SolidColorBrush x:Key="SidebarSelectedBackground" Color="{StaticResource SidebarSelectedColor}"/>
    <SolidColorBrush x:Key="SidebarSeparatorBrush" Color="#FF2C2E3A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="ContentBackground" Color="{StaticResource ContentColor}"/>
    <SolidColorBrush x:Key="CardBackground" Color="White"/>
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="#FF2D2F3A"/>
    <SolidColorBrush x:Key="ChromeCloseHoverBrush" Color="#FFE81123"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#FFFCFCFD"/>
    <SolidColorBrush x:Key="ToolBorderBrush" Color="#FFDADBDF"/>
    <SolidColorBrush x:Key="ToolHoverBrush" Color="#FFF0F2F6"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FFE6E7EC"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#FFEEF0F3"/>
    <SolidColorBrush x:Key="TabStripBackground" Color="#FFE8EAEE"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1F2229"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5C6070"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF8A8E9C"/>
    <SolidColorBrush x:Key="BadgeBlueBackground" Color="#FFE8F0FE"/>
    <SolidColorBrush x:Key="BadgeBlueForeground" Color="#FF1B5ECC"/>
    <SolidColorBrush x:Key="BadgeGreenBackground" Color="#FFE4F5E7"/>
    <SolidColorBrush x:Key="BadgeGreenForeground" Color="#FF177A2B"/>
    <SolidColorBrush x:Key="BadgeAmberBackground" Color="#FFFDF0D8"/>
    <SolidColorBrush x:Key="BadgeAmberForeground" Color="#FF9A5B00"/>
    <SolidColorBrush x:Key="BadgeGrayBackground" Color="#FFEFF0F3"/>
    <SolidColorBrush x:Key="BadgeGrayForeground" Color="#FF5C6070"/>

    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4D9BFF" Offset="0"/>
        <GradientStop Color="#FF1F5FDB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StartPageBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDFEFF" Offset="0"/>
        <GradientStop Color="#FFEDF2FC" Offset="1"/>
    </LinearGradientBrush>

    <sys:Double x:Key="CaptionHeight">42</sys:Double>

    <!-- ================= Text styles ================= -->

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{StaticResource TitleBarDimForeground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ================= Window caption buttons ================= -->

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="{StaticResource CaptionHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#FFC9CBD6"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChromeButtonBackground" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChromeButtonBackground" Property="Background" Value="{StaticResource ChromeHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ChromeButtonBackground" Property="Background" Value="#FF23242E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChromeButtonBackground" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChromeButtonBackground" Property="Background" Value="{StaticResource ChromeCloseHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ChromeButtonBackground" Property="Background" Value="#FFB30A1B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Toolbar buttons ================= -->

    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ToolButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToolButtonBorder" Property="Background" Value="{StaticResource ToolHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ToolButtonBorder" Property="Background" Value="#FFE2E5EB"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FFB4B7C0"/>
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PrimaryButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PrimaryButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PrimaryButtonBorder" Property="Background" Value="#FF1653AE"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#FFC6CBD6"/>
                            <Setter Property="Foreground" Value="#FFFDFDFE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="SecondaryButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource ToolBorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SecondaryButtonBorder" Property="Background" Value="#FFF5F7FB"/>
                            <Setter TargetName="SecondaryButtonBorder" Property="BorderBrush" Value="#FFB9BFD0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SecondaryButtonBorder" Property="Background" Value="#FFECEFF5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FFB4B7C0"/>
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Dark sidebar search box ================= -->

    <Style x:Key="SidebarSearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="#FF262833"/>
        <Setter Property="Foreground" Value="#FFE6E7EE"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="BorderBrush" Value="#FF343746"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="#FF3F6EC4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="SearchBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="#FF6E7183" VerticalAlignment="Center" Margin="9,0,0,0"/>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="4,0,4,0"
                                          VerticalAlignment="Center"/>
                            <TextBlock x:Name="HintTextElement" Grid.Column="1" Text="{TemplateBinding Tag}"
                                       Foreground="#FF6E7183" FontSize="11.5" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Margin="5,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="SearchBorder" Property="BorderBrush" Value="#FF4D9BFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Sidebar sample list ================= -->

    <Style x:Key="SidebarListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="SidebarItemBorder" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Margin="8,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="SelectedBar" Width="3" CornerRadius="2" Margin="0,8"
                                                Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                                        <ContentPresenter Grid.Column="1" Margin="2,0,8,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SidebarItemBorder" Property="Background" Value="{StaticResource SidebarHoverBackground}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="SidebarItemBorder" Property="Background" Value="{StaticResource SidebarSelectedBackground}"/>
                                        <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Badges ================= -->

    <Style x:Key="BadgeBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Background" Value="{StaticResource BadgeGrayBackground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{StaticResource BadgeGrayForeground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ================= Start page cards ================= -->

    <Style x:Key="SampleCard" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CardTranslate" Y="0"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.14" Color="#33425C"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFB9CFFB"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                         Storyboard.TargetProperty="Y"
                                                         To="-2" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Slim scrollbars ================= -->

    <Style x:Key="SlimScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="#CDD0D8" CornerRadius="4" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#AEB2BD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="10"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
