<Window x:Class="ObjectViewer.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Object Viewer Studio"
        Height="820" Width="1420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnWindowClosing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sidebar sample item -->
        <DataTemplate x:Key="SampleItemTemplate">
            <Grid Margin="12,7,10,7" AutomationProperties.Name="{Binding Manifest.Title}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Manifest.Icon}" FontSize="17" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Manifest.Title}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource SidebarForeground}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Manifest.Description}" FontSize="10" Margin="0,3,0,0"
                               Foreground="{StaticResource SidebarDimForeground}"
                               TextTrimming="CharacterEllipsis" MaxHeight="27" LineStackingStrategy="BlockLineHeight"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Category group header -->
        <DataTemplate x:Key="SampleGroupHeaderTemplate">
            <Border Margin="18,10,12,5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Height="12" CornerRadius="2" Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SidebarDimForeground}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Document tab (event handler must resolve against this window's code-behind) -->
        <Style x:Key="DocumentTab" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="#FFD8DBE2" BorderThickness="0,0,1,0"
                                Padding="14,0,6,0" MinWidth="170" MaxWidth="240">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TabIcon" Text="{Binding Sample.Manifest.Icon}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="TabTitle" Grid.Column="1" Text="{Binding Title}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Ellipse x:Name="DirtyDot" Grid.Column="2" Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                         VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/>
                                <Button x:Name="TabClose" Grid.Column="3" Click="OnTabCloseClick" Width="24" Height="24"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        VerticalAlignment="Center" ToolTip="关闭 (Ctrl+W)">
                                    <TextBlock x:Name="TabCloseGlyph" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFF3F4F7"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter TargetName="DirtyDot" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource ContentBackground}">
        <DockPanel>

            <!-- ======================= Title bar ======================= -->
            <Border DockPanel.Dock="Top" Height="42" Background="{StaticResource TitleBarBackground}">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource LogoBrush}">
                            <TextBlock Text="◈" FontSize="13" Foreground="White" FontFamily="Segoe UI Symbol"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Object Viewer Studio" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBarForeground}" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                        <Border Background="#FF2C2E3A" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="DEMO" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TitleBarDimForeground}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="TitleDocumentText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick"
                                ToolTip="最小化">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeClick"
                                ToolTip="最大化 / 还原">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseClick" ToolTip="关闭">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= Status bar ======================= -->
            <Border DockPanel.Dock="Bottom" Height="26" Background="{StaticResource StatusBarBackground}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                 Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusDocumentText" Style="{StaticResource HintText}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        <TextBlock x:Name="StatusVersionText" Style="{StaticResource HintText}" Margin="14,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= Main area ======================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="308"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Sidebar ===== -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,14,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="示例库" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarForeground}"/>
                                <TextBlock Text="SAMPLE LIBRARY" FontSize="9" Margin="0,2,0,0"
                                           Foreground="{StaticResource SidebarDimForeground}"/>
                            </StackPanel>
                            <Button x:Name="RefreshLibraryButton" Grid.Column="1" Click="OnRefreshLibraryClick"
                                    ToolTip="重新扫描示例文件夹" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" VerticalAlignment="Center" Width="26" Height="26">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource SidebarDimForeground}"/>
                            </Button>
                        </Grid>

                        <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                            <TextBox x:Name="SearchBox" Style="{StaticResource SidebarSearchBox}"
                                      Tag="搜索示例…" TextChanged="OnSearchTextChanged"/>
                        </Grid>

                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SidebarSeparatorBrush}"
                                BorderThickness="0,1,0,0" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SampleCountText" Style="{StaticResource HintText}"
                                           Foreground="{StaticResource SidebarDimForeground}"/>
                                <Button Grid.Column="1" Click="OnOpenSamplesFolderClick" ToolTip="在资源管理器中打开"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Width="24" Height="24" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{StaticResource SidebarDimForeground}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <ListBox x:Name="SampleList" Style="{StaticResource SidebarListBox}"
                                 ItemTemplate="{StaticResource SampleItemTemplate}"
                                 SelectionChanged="OnSampleSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 KeyDown="OnSampleListKeyDown">
                            <ListBox.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource SampleGroupHeaderTemplate}"/>
                            </ListBox.GroupStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- ===== Splitter ===== -->
                <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                             ShowsPreview="False" Cursor="SizeWE"/>

                <!-- ===== Content ===== -->
                <Border Grid.Column="2" Background="{StaticResource ContentBackground}">
                    <DockPanel>

                        <!-- Toolbar -->
                        <Border DockPanel.Dock="Top" Height="46" Background="{StaticResource ToolbarBackground}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ToolButton}" Click="OnOpenFileClick" ToolTip="打开数据源或示例文件 (Ctrl+O)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="打开…" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Click="OnReloadClick" Margin="6,0,0,0"
                                            x:Name="ReloadButton" ToolTip="从磁盘重新加载当前示例">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="重新加载" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Width="1" Height="22" Background="{StaticResource BorderSubtleBrush}"
                                            Margin="10,0,4,0" VerticalAlignment="Center"/>
                                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Click="OnSaveClick"
                                            ToolTip="保存当前示例 (Ctrl+S)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="保存" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SaveAsButton" Style="{StaticResource SecondaryButton}" Click="OnSaveAsClick"
                                            Margin="8,0,0,0" ToolTip="另存为新的 JSON 文件">
                                        <TextBlock Text="另存为…"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource HintText}" Text="双击 / F2 编辑成员 · Ctrl+S 保存 · Ctrl+W 关闭标签"/>
                            </Grid>
                        </Border>

                        <!-- Document tab strip -->
                        <Border DockPanel.Dock="Top" Height="34" Background="{StaticResource TabStripBackground}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="TabStrip">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource DocumentTab}" GroupName="DocumentTabs"
                                                         IsChecked="{Binding IsCurrent, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Document host / start page -->
                        <Grid>
                            <ContentControl x:Name="DocumentHost"/>
                        </Grid>

                    </DockPanel>
                </Border>

            </Grid>
        </DockPanel>
    </Border>
</Window>
